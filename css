@import url('https://fonts.cdnfonts.com/css/waltograph');

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'Avenir', 'Helvetica Neue', Helvetica, Arial, sans-serif;
}

body {
    background-color: #040714; 
    color: #f9f9f9;
    overflow-x: hidden;
}

.font-disney {
    font-family: 'Waltograph', sans-serif;
    font-weight: normal;
    letter-spacing: 2px;
}

.plus-sign {
    font-family: 'Avenir', sans-serif;
    vertical-align: super;
    background: -webkit-linear-gradient(45deg, #ff7eb3, #ff0000);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

/* --- ÉCRAN DE CONNEXION --- */
#login-screen {
    height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    background-color: #1a1d29;
}

.logo-rosa {
    font-size: 5rem;
    margin-bottom: 30px;
    color: #fff5f7;
}

.logo-rosa .plus-sign {
    font-size: 3.5rem;
}

#login-screen h2 {
    font-size: 1.8rem;
    font-weight: 500;
    margin-bottom: 40px;
}

.profile {
    cursor: pointer;
}

.profile img {
    width: 150px;
    height: 150px;
    border-radius: 50%;
    border: 3px solid transparent;
    transition: all 0.3s ease;
    object-fit: cover;
}

.profile:hover img {
    border-color: #f9f9f9;
    transform: scale(1.05);
}

.profile p {
    text-align: center;
    margin-top: 15px;
    font-size: 1.2rem;
    color: #cacaca;
}

.profile:hover p {
    color: white;
}

/* --- ANIMATION INTRO CINÉMA --- */
#intro-screen {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background-color: #000000;
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 9999; 
}

.intro-logo {
    font-size: 6rem;
    color: #fff5f7;
    opacity: 0; 
    animation: cinemaEffect 4s ease-in-out forwards;
}

.intro-logo .plus-sign {
    font-size: 4.5rem;
}

@keyframes cinemaEffect {
    0% { opacity: 0; transform: scale(0.5); }
    20% { opacity: 1; transform: scale(1); text-shadow: 0 0 20px rgba(255,126,179,0.5); }
    80% { opacity: 1; transform: scale(1.2); text-shadow: 0 0 40px rgba(255,0,0,0.8); }
    100% { opacity: 0; transform: scale(1.5); }
}

/* --- NAVBAR STYLE DISNEY+ (AVEC ICÔNES) --- */
.navbar {
    position: fixed;
    top: 0;
    width: 100%;
    height: 70px;
    background: #090b13;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 36px;
    z-index: 100;
}

.nav-left {
    display: flex;
    align-items: center;
}

.nav-logo-text {
    color: #fff5f7;
    font-size: 28px;
    margin-right: 30px;
    padding-top: 5px;
}

.nav-logo-text .plus-sign {
    font-size: 22px;
}

.nav-links {
    display: flex;
    align-items: center;
}

.nav-links a {
    color: #f9f9f9;
    text-decoration: none;
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 1.2px;
    margin-right: 20px;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 10px;
    border-radius: 4px;
    transition: background 0.2s;
}

.nav-links a svg {
    width: 18px;
    height: 18px;
    fill: #f9f9f9;
}

.nav-links a:hover {
    background: rgba(255, 255, 255, 0.1);
}

.profile-switch-btn {
    color: #cacaca;
    text-decoration: none;
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 1.2px;
    transition: color 0.2s;
}

.profile-switch-btn:hover {
    color: white;
}

/* --- BARRE DE FILTRES EN "PILULES" (STYLE DISNEY+) --- */
.sub-nav-pills {
    margin-top: 70px; /* Décale sous la navbar fixe */
    padding: 20px 36px 10px 36px;
    display: flex;
    gap: 15px;
}

.pill {
    background-color: #1a1d29;
    border: 1px solid rgba(255, 255, 255, 0.15);
    padding: 8px 20px;
    border-radius: 20px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    color: #cacaca;
}

.pill:hover {
    background-color: rgba(255, 255, 255, 0.2);
    color: white;
}

.pill.active {
    background-color: white;
    color: black;
    border-color: white;
}

/* --- GRANDE AFFICHE (HERO) --- */
.hero-slider {
    padding: 10px 36px 20px 36px;
}

.hero-image {
    width: 100%;
    height: 55vh;
    border-radius: 10px;
    background: linear-gradient(to right, rgba(4,7,20,1) 0%, rgba(4,7,20,0) 100%), 
                url('https://images.unsplash.com/photo-1518173946687-a4c8892bbd9f?ixlib=rb-1.2.1&auto=format&fit=crop&w=1920&q=80') center/cover;
    box-shadow: rgb(0 0 0 / 69%) 0px 26px 30px -10px;
    display: flex;
    align-items: center;
    padding: 40px;
}

.hero-content h1 {
    font-size: 3.5rem;
    margin-bottom: 10px;
}

.hero-content p {
    font-size: 1.1rem;
    color: #cacaca;
}

.hero-buttons {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-top: 20px;
}

.play-btn {
    background: rgb(249, 249, 249);
    border: none;
    padding: 0px 24px;
    height: 50px;
    border-radius: 4px;
    font-size: 14px;
    font-weight: bold;
    display: flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    transition: background 0.2s;
    letter-spacing: 1.5px;
    color: black;
}

.play-btn:hover {
    background: rgb(198, 198, 198);
}

.add-btn {
    height: 45px;
    width: 45px;
    border-radius: 50%;
    border: 2px solid white;
    background: rgba(0, 0, 0, 0.6);
    color: white;
    font-size: 24px;
    display: flex;
    justify-content: center;
    align-items: center;
    cursor: pointer;
}

.add-btn:hover {
    background: white;
    color: black;
}

/* --- LES CASES STUDIOS --- */
.brand-container {
    padding: 20px 36px;
    display: grid;
    grid-template-columns: repeat(4, 1fr); 
    gap: 25px;
}

.brand-box {
    border-radius: 10px;
    height: 110px;
    background: linear-gradient(rgb(48, 50, 62), rgb(30, 31, 42));
    border: 3px solid rgba(249, 249, 249, 0.1);
    box-shadow: rgb(0 0 0 / 69%) 0px 26px 30px -10px, rgb(0 0 0 / 73%) 0px 16px 10px -10px;
    transition: all 250ms cubic-bezier(0.25, 0.46, 0.45, 0.94) 0s;
    display: flex;
    justify-content: center;
    align-items: center;
    cursor: pointer;
    font-weight: bold;
    letter-spacing: 2px;
    color: #cacaca;
}

.brand-box:hover {
    box-shadow: rgb(0 0 0 / 80%) 0px 40px 58px -16px, rgb(0 0 0 / 72%) 0px 30px 22px -10px;
    transform: scale(1.05);
    border-color: rgba(249, 249, 249, 0.8);
    color: white;
}

/* --- RANGÉES DE FILMS --- */
.catalog-section {
    padding: 0 36px 50px 36px;
}

.catalog-section h4 {
    font-size: 20px;
    margin-bottom: 20px;
}

.carousel {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    padding-bottom: 20px;
    scrollbar-width: none;
}

.carousel::-webkit-scrollbar {
    display: none;
}

.movie-card {
    min-width: 250px;
    aspect-ratio: 16/9;
    background: #1e1f2a;
    border-radius: 10px;
    box-shadow: rgb(0 0 0 / 69%) 0px 26px 30px -10px;
    cursor: pointer;
    border: 3px solid rgba(249, 249, 249, 0.1);
    transition: all 250ms cubic-bezier(0.25, 0.46, 0.45, 0.94) 0s;
    display: flex;
    justify-content: center;
    align-items: center;
    color: #888;
    font-weight: bold;
    font-size: 1.2rem;
}

.movie-card:hover {
    box-shadow: rgb(0 0 0 / 80%) 0px 40px 58px -16px;
    transform: scale(1.05);
    border-color: rgba(249, 249, 249, 0.8);
    color: white;
}
